{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2025"],
    "types": ["node"]
  },
  "include": [
    "**/*.mjs",
    "**/*.cjs",
    "**/*.js",
    ".claude/**/*.mjs",
    ".claude/**/*.cjs",
    ".claude/**/*.js"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/tmp",
    "**/out-tsc",
    "**/storybook-static",
    "**/vitest.config.*.timestamp*",
    "coverage",
    "vendor",
    "docs/specs",
    ".claude/worktrees",
    ".nx",
    ".angular"
  ]
}
