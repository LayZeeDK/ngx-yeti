{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2025",
    "module": "esnext",
    "lib": ["es2025", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "ngx-yeti": ["./packages/ngx-yeti/src/index.ts"],
      "@ngx-yeti/testing": ["./packages/ngx-yeti-testing/src/index.ts"],
      "@ngx-yeti/testing/server": ["./packages/ngx-yeti-testing/src/server.ts"],
      "@ngx-yeti/testing/playwright": [
        "./packages/ngx-yeti-testing/src/playwright.ts"
      ],
      "ngx-yeti/styles": ["./packages/ngx-yeti/styles/src/index.ts"],
      "ngx-yeti/card": ["./packages/ngx-yeti/card/src/index.ts"],
      "ngx-yeti/lift": ["./packages/ngx-yeti/lift/src/index.ts"],
      "ngx-yeti/box": ["./packages/ngx-yeti/box/src/index.ts"],
      "ngx-yeti/breakout": ["./packages/ngx-yeti/breakout/src/index.ts"],
      "ngx-yeti/button": ["./packages/ngx-yeti/button/src/index.ts"],
      "ngx-yeti/center": ["./packages/ngx-yeti/center/src/index.ts"],
      "ngx-yeti/cluster": ["./packages/ngx-yeti/cluster/src/index.ts"],
      "ngx-yeti/columns": ["./packages/ngx-yeti/columns/src/index.ts"],
      "ngx-yeti/container": ["./packages/ngx-yeti/container/src/index.ts"],
      "ngx-yeti/cover": ["./packages/ngx-yeti/cover/src/index.ts"],
      "ngx-yeti/enter": ["./packages/ngx-yeti/enter/src/index.ts"],
      "ngx-yeti/frame": ["./packages/ngx-yeti/frame/src/index.ts"],
      "ngx-yeti/grid": ["./packages/ngx-yeti/grid/src/index.ts"],
      "ngx-yeti/icon": ["./packages/ngx-yeti/icon/src/index.ts"],
      "ngx-yeti/layer": ["./packages/ngx-yeti/layer/src/index.ts"],
      "ngx-yeti/masonry": ["./packages/ngx-yeti/masonry/src/index.ts"],
      "ngx-yeti/overlay": ["./packages/ngx-yeti/overlay/src/index.ts"],
      "ngx-yeti/scroller": ["./packages/ngx-yeti/scroller/src/index.ts"],
      "ngx-yeti/sidebar": ["./packages/ngx-yeti/sidebar/src/index.ts"],
      "ngx-yeti/spinner": ["./packages/ngx-yeti/spinner/src/index.ts"],
      "ngx-yeti/stack": ["./packages/ngx-yeti/stack/src/index.ts"],
      "ngx-yeti/table": ["./packages/ngx-yeti/table/src/index.ts"],
      "ngx-yeti/timeline": ["./packages/ngx-yeti/timeline/src/index.ts"],
      "ngx-yeti/visually-hidden": [
        "./packages/ngx-yeti/visually-hidden/src/index.ts"
      ]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "checkJs": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "tmp"],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "extendedDiagnostics": {
      "defaultCategory": "error"
    },
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictStandalone": true,
    "strictTemplates": true,
    "strictUnclaimedEventNames": true,
    "typeCheckHostBindings": true
  }
}
