{
  "extraKnownMarketplaces": {
    "angular-skills": {
      "source": {
        "source": "settings",
        "name": "angular-skills",
        "plugins": [
          {
            "name": "angular-developer",
            "source": {
              "source": "git-subdir",
              "url": "angular/skills",
              "path": "angular-developer"
            },
            "description": "Angular's official angular-developer skill from angular/skills"
          },
          {
            "name": "angular-new-app",
            "source": {
              "source": "git-subdir",
              "url": "angular/skills",
              "path": "angular-new-app"
            },
            "description": "Angular's official angular-new-app skill from angular/skills"
          }
        ],
        "owner": {
          "name": "Angular"
        }
      }
    },
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "enabledPlugins": {
    "angular-developer@angular-skills": true,
    "angular-new-app@angular-skills": true,
    "nx@nx-claude-plugins": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["/tmp/.nx", "~/.nx"],
      "allowWrite": ["/tmp/.nx", "~/.nx"]
    },
    "network": {
      "allowUnixSockets": ["/tmp/.nx", "~/.nx"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.gsd-path/guard_hook.py\""
          }
        ]
      }
    ]
  },
