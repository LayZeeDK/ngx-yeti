{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.*",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": [],
    "storybook": [
      {
        "externalDependencies": [
          "storybook",
          "@storybook/addon-vitest",
          "@storybook/angular-vite",
          "@analogjs/vite-plugin-angular",
          "vite"
        ]
      }
    ]
  },
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "@nx/angular:package": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "build-storybook": {
      "cache": true,
      "inputs": ["default", "^production", "storybook"],
      "configurations": {
        "fast": {
          "env": {
            "ANGULAR_FAST_COMPILE": "true"
          }
        }
      }
    },
    "test-storybook": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "storybook",
        {
          "externalDependencies": [
            "vitest",
            "@vitest/browser-playwright",
            "@vitest/coverage-istanbul",
            "playwright"
          ]
        },
        {
          "env": "CI"
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "configurations": {
        "fast": {
          "env": {
            "ANGULAR_FAST_COMPILE": "true"
          }
        }
      }
    },
    "typecheck-watch": {
      "continuous": true,
      "command": "nx watch --projects={projectName} --includeDependencies --initialRun -- nx typecheck {projectName}"
    },
    "typecheck": [
      {
        "executor": "angular-typechecker:typecheck",
        "cache": true,
        "outputs": [],
        "inputs": [
          "default",
          "{projectRoot}/tsconfig*.json",
          "{projectRoot}/package.json",
          "{workspaceRoot}/tsconfig.base.json",
          "^default",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "externalDependencies": ["typescript", "@angular/compiler-cli"]
          }
        ],
        "options": {
          "tsConfig": "{projectRoot}/tsconfig.json",
          "maxWarnings": 0,
          "strict": true
        },
        "configurations": {
          "spec": {
            "tsConfig": "{projectRoot}/tsconfig.spec.json"
          }
        }
      },
      {
        "filter": {
          "projects": ["tag:type:lib"]
        },
        "configurations": {
          "src": {
            "tsConfig": "{projectRoot}/tsconfig.lib.json"
          }
        }
      },
      {
        "filter": {
          "projects": ["tag:type:app"]
        },
        "configurations": {
          "src": {
            "tsConfig": "{projectRoot}/tsconfig.app.json"
          }
        }
      },
      {
        "filter": {
          "projects": ["tag:storybook"]
        },
        "configurations": {
          "stories": {
            "tsConfig": "{projectRoot}/.storybook/tsconfig.json"
          }
        }
      }
    ],
    "storybook": {
      "configurations": {
        "fast": {
          "env": {
            "ANGULAR_FAST_COMPILE": "true"
          }
        }
      }
    },
    "static-storybook": {
      "configurations": {
        "fast": {
          "buildTarget": "build-storybook:fast"
        }
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/storybook/plugin",
      "options": {
        "serveStorybookTargetName": "storybook",
        "buildStorybookTargetName": "build-storybook",
        "testStorybookTargetName": "test-storybook",
        "staticStorybookTargetName": "static-storybook",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "include": ["apps/yeti-analog/**/*"]
    },
    {
      "plugin": "@nx/vitest",
      "include": ["apps/yeti-analog/**/*"],
      "options": {
        "testMode": "run"
      }
    }
  ],
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "playwright",
      "linter": "eslint",
      "style": "css",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:component": {
      "style": "css"
    }
  },
  "release": {
    "version": {
      "preVersionCommand": "npx nx run-many -t build"
    }
  }
}
