{
  "name": "ngx-yeti-testing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["yeti-css"],
  "sourceRoot": "packages/ngx-yeti-testing/src",
  "projectType": "library",
  "tags": ["type:testing"],
  "targets": {
    "test": {
      "command": "vitest run --config vitest.config.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/playwright/engines.mjs",
        {
          "env": "CI"
        },
        {
          "env": "BROWSERS"
        },
        {
          "env": "FIREFOX_PATH"
        }
      ]
    },
    "typecheck": {}
  }
}
