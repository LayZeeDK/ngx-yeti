{
  "name": "ngx-yeti",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["yeti-css"],
  "sourceRoot": "packages/ngx-yeti/src",
  "prefix": "yeti",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["type:lib", "storybook"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/ngx-yeti/ng-package.json",
        "tsConfig": "packages/ngx-yeti/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ngx-yeti/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "command": "vitest run --config vitest.unit.config.mts",
      "dependsOn": ["^yeti-build"],
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "env": "CI"
        },
        {
          "env": "FLOOR_CHROMIUM_PATH"
        },
        {
          "env": "FLOOR_FIREFOX"
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/unit/{projectRoot}"]
    },
    "storybook": {
      "options": {
        "port": 4400
      }
    },
    "static-storybook": {
      "options": {
        "port": 4401
      }
    },
    "typecheck": {
      "dependsOn": ["^yeti-build"]
    },
    "lint": {
      "dependsOn": ["^yeti-build"]
    },
    "build-fast": {
      "command": "vite build --config vite.lib.config.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "externalDependencies": [
            "vite",
            "@analogjs/vite-plugin-angular",
            "@angular/compiler",
            "@angular/compiler-cli",
            "typescript",
            "rolldown",
            "rolldown-plugin-dts"
          ]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/fast/{projectRoot}"],
      "configurations": {
        "js": {
          "command": "vite build --config vite.lib.config.mts --mode js"
        }
      }
    },
    "typecheck-watch": {}
  }
}
